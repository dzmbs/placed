{
  "name": "placement-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "test": "node --import tsx --test tests/*.test.ts",
    "contracts:setup": "cd contracts && forge install OpenZeppelin/openzeppelin-contracts@v5.4.0 --no-git && forge install foundry-rs/forge-std@v1.10.0 --no-git",
    "contracts:build": "cd contracts && forge build",
    "contracts:test": "cd contracts && forge test --offline",
    "contracts:fork": "cd contracts && SEPOLIA_FORK_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com forge test --match-contract SepoliaIntegrationTest",
    "contracts:abi": "node --import tsx scripts/export_contract_abis.ts",
    "contracts:deploy": "node --env-file=.env.local --import tsx scripts/deploy_marketplace.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:models": "node --import tsx scripts/verify_models.ts",
    "check": "npm run format:check && npm run typecheck && npm test && npm run verify:models && npm run build",
    "verify:marketplace": "node --import tsx scripts/verify_marketplace_api.ts",
    "world:staging": "node --env-file=.env.local --import tsx scripts/world_staging.ts"
  },
  "dependencies": {
    "@privy-io/react-auth": "3.45.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@stripe/stripe-js": "^9.17.0",
    "@worldcoin/idkit": "4.3.0",
    "@worldcoin/idkit-core": "4.3.0",
    "idb-keyval": "^6.2.1",
    "lucide-react": "^1.48.0",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "three": "^0.186.1",
    "viem": "2.56.9"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "fake-indexeddb": "^6.2.5",
    "prettier": "3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "overrides": {
    "ws@>=8 <9": "8.21.0"
  }
}
